# ============================================================
# Security rules sent with every page (Cloudflare reads this file; tests/serve.js applies it locally too).
# The app may only load its own files. No outside scripts, styles, fonts or connections, with one exception:
# Cloudflare's anonymous visit counting (script from static.cloudflareinsights.com, counts sent to cloudflareinsights.com),
# which the app loads only when counting is allowed (see src/visits.js).
# ============================================================
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Pictures never change at the same address (the page adds a fingerprint), so phones may keep them for a year.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself is always re-checked, so updates show up straight away.
/index.html
  Cache-Control: no-cache

# Code and styles carry a fingerprint in their address too.
/app.js
  Cache-Control: public, max-age=31536000, immutable
/app.css
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: no-cache

# Fonts also carry a fingerprint in their address.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The offline helper and the app description are always re-checked, so new versions are found.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/icons/*
  Cache-Control: public, max-age=86400
